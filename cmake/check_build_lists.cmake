file(READ "${ROOT}/meson.build" MESON)
file(READ "${ROOT}/ya.make" YA_LIB)
file(READ "${ROOT}/yasl/test/ya.make" YA_TEST)

file(GLOB_RECURSE FILES RELATIVE "${ROOT}" "${ROOT}/yasl/*.cpp")
set(BAD 0)
foreach(F ${FILES})
    if(F MATCHES "^yasl/bench/")
        set(LISTS MESON)
    elseif(F MATCHES "_test\\.cpp$" OR F MATCHES "^yasl/test/")
        set(LISTS MESON YA_TEST)
    else()
        set(LISTS MESON YA_LIB)
    endif()
    foreach(L ${LISTS})
        string(FIND "${${L}}" "${F}" POS)
        if(POS EQUAL -1 AND L STREQUAL "MESON" AND F MATCHES "/mem/(sys|os_pages)_[a-z]+\\.cpp$")
            continue()
        endif()
        if(POS EQUAL -1)
            message(SEND_ERROR "${F} is not listed in the ${L} build file")
            set(BAD 1)
        endif()
    endforeach()
endforeach()
if(NOT BAD)
    message(STATUS "build file lists: OK")
endif()
